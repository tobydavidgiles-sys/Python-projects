import tkinter as tk

root = tk.Tk()
root.title("calculator")
root.geometry("600x400")

x = ""
y = ""
input1 = ""
input2 = ""
arithmeticSelected = ""

Bar = tk.Label(root, text=x, font=("Arial", 24))
Bar.pack(pady=10)

def onClick(Num):
    global x, y, input1, input2, arithmeticSelected

    if isinstance(Num, int):  # Number clicked
        if arithmeticSelected:  # second number
            y += str(Num)
            Bar.config(text=y)
        else:                  # first number
            x += str(Num)
            Bar.config(text=x)
    else:  # Operator clicked
        if not arithmeticSelected:
            
            arithmeticSelected = Num


def Cancel():
    global x, y, input1, input2, arithmeticSelected, result
    x = ""
    y = ""
    input1 = ""
    input2 = ""
    arithmeticSelected = ""
    result = ""
    Bar.config(text="")



def Calculate():
    global x, y, arithmeticSelected, result

    if not x or not y or not arithmeticSelected:
        return

    num1 = float(x)
    num2 = float(y)

    if arithmeticSelected == "+":
        result = num1 + num2
    elif arithmeticSelected == "-":
        result = num1 - num2
    elif arithmeticSelected == "x":
        result = num1 * num2
    elif arithmeticSelected == "/":
        result = num1 / num2

    Bar.config(text=str(result))

    # reset for next calculation
    x = str(result)
    y = ""
    arithmeticSelected = ""
    

buttons = [
    (1, 100, 100), (2, 150, 100), (3, 200, 100),
    (4, 100, 150), (5, 150, 150), (6, 200, 150),
    (7, 100, 200), (8, 150, 200), (9, 200, 200),
    (0, 150, 250)
]

arithmetic = [
    ("+",300, 100), ("-", 300, 150),("x", 300, 200),("/", 300, 250)
]

for num, xpos, ypos in buttons:
    tk.Button(root, text=str(num), width=5, height=2, command=lambda n=num: onClick(n)).place(x=xpos, y=ypos)

for form, xpos, ypos in arithmetic:
    tk.Button(root, text=form, width=5, height=2, command=lambda a=form: onClick(a)).place(x=xpos, y=ypos)

Equate = tk.Button(root, text="=", width=5, height=2, command=Calculate)
Equate.place(x=300, y=300)

Cancel = tk.Button(root, text="Clear",width=6, height=3, command=Cancel)
Cancel.place(x=400, y=200)

root.mainloop()
